{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["cards"],
  "properties": {
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "front", "back", "transcription", "example_foreign", "example_ru", "tags", "source"],
        "properties": {
          "type": {"const": "vocab"},
          "front": {"type": "string", "minLength": 1},
          "back": {"type": "string", "minLength": 1},
          "transcription": {"type": "string", "minLength": 1},
          "example_foreign": {"type": ["string", "null"]},
          "example_ru": {"type": ["string", "null"]},
          "tags": {"type": "array", "items": {"type": "string"}},
          "source": {
            "type": "object",
            "required": ["kind", "ref"],
            "properties": {
              "kind": {"enum": ["youtube", "ocr", "text"]},
              "ref": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
